    <script>
    (function() {
      var openBtn = document.getElementById('pw-cart-open-btn');
      var closeBtn = document.getElementById('pw-cart-close-btn');
      var backdrop = document.getElementById('pw-cart-backdrop');
      var drawer = document.getElementById('pw-cart-drawer');
      var counter = document.getElementById('cart-counter-display');

      var themeToggleBtn = document.getElementById('theme-toggle-btn');
      if (themeToggleBtn) {
        var isDark = document.documentElement.classList.contains('dark-mode');
        
        function updateThemeIcon(dark) {
          var sun = themeToggleBtn.querySelector('.theme-icon-sun');
          var moon = themeToggleBtn.querySelector('.theme-icon-moon');
          if (sun && moon) {
            if (dark) {
              sun.style.display = 'none';
              moon.style.display = 'block';
            } else {
              sun.style.display = 'block';
              moon.style.display = 'none';
            }
          }
        }
        
        updateThemeIcon(isDark);

        themeToggleBtn.addEventListener('click', function() {
          isDark = document.documentElement.classList.toggle('dark-mode');
          updateThemeIcon(isDark);
          localStorage.setItem('pitwall-theme', isDark ? 'dark' : 'light');
        });
      }

      function openCart() {
        refreshCart();
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function closeCart() {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      function formatMoney(cents) {
        return '₹' + (cents / 100).toLocaleString('en-IN');
      }

      function refreshCart() {
        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var count = cart.item_count || 0;
            counter.textContent = count;

            var itemsEl = document.getElementById('pw-cart-items');
            var footerEl = document.getElementById('pw-cart-footer');
            var emptyEl = document.getElementById('pw-cart-empty');
            var subtotalEl = document.getElementById('pw-cart-subtotal-value');

            if (count === 0) {
              itemsEl.innerHTML = '';
              footerEl.style.display = 'none';
              emptyEl.style.display = 'flex';
            } else {
              emptyEl.style.display = 'none';
              footerEl.style.display = 'block';
              subtotalEl.textContent = formatMoney(cart.total_price);

              itemsEl.innerHTML = cart.items.map(function(item) {
                return '<div class="pw-cart-item">' +
                  '<div class="pw-cart-item-img-wrap">' +
                    (item.image ? '<img src="' + item.image + '" alt="' + item.title + '" class="pw-cart-item-img" />' : '<div class="pw-cart-item-img-placeholder"></div>') +
                  '</div>' +
                  '<div class="pw-cart-item-info">' +
                    '<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">' +
                      '<span class="pw-cart-item-title">' + item.product_title + '</span>' +
                      '<button class="pw-cart-item-remove-btn" data-variant-id="' + item.variant_id + '" aria-label="Remove item">' +
                        '<svg class="pw-cart-item-remove-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>' +
                      '</button>' +
                    '</div>' +
                    (item.variant_title && item.variant_title !== 'Default Title' ? '<span class="pw-cart-item-variant">' + item.variant_title + '</span>' : '') +
                    '<div class="pw-cart-item-row">' +
                      '<span class="pw-cart-item-qty">QTY: ' + item.quantity + '</span>' +
                      '<span class="pw-cart-item-price">' + formatMoney(item.line_price) + '</span>' +
                    '</div>' +
                  '</div>' +
                '</div>';
              }).join('');
            }
          });
      }

      if (openBtn) openBtn.addEventListener('click', openCart);
      if (closeBtn) closeBtn.addEventListener('click', closeCart);
      if (backdrop) backdrop.addEventListener('click', closeCart);

      var itemsContainer = document.getElementById('pw-cart-items');
      if (itemsContainer) {
        itemsContainer.addEventListener('click', function(e) {
          var removeBtn = e.target.closest('.pw-cart-item-remove-btn');
          if (removeBtn) {
            var variantId = removeBtn.getAttribute('data-variant-id');
            if (variantId) {
              removeBtn.style.opacity = '0.35';
              removeBtn.disabled = true;
              fetch('/cart/change.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  id: variantId,
                  quantity: 0
                })
              })
              .then(function(res) { return res.json(); })
              .then(function(cart) {
                refreshCart();
                document.dispatchEvent(new CustomEvent('cart:refresh'));
              })
              .catch(function(err) {
                console.error('Failed to remove item from cart', err);
                refreshCart();
              });
            }
          }
        });
      }

      // Refresh count on page load
      fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
        if (counter) counter.textContent = cart.item_count || 0;
      });

      // Listen for Shopify cart updates
      document.addEventListener('cart:refresh', refreshCart);
    })();
    </script>

    <!-- Bundled React + Three.js components -->
    {{ 'pitwall-interactive.js' | asset_url | script_tag }}
  </body>
</html>
