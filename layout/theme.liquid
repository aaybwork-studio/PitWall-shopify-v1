<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Pitwall Custom brutalist CSS -->
    <link href="{{ 'pitwall-style.css' | asset_url | replace: '.css.liquid', '.css' }}" rel="stylesheet" type="text/css" media="all" />
    <!-- Compiled Tailwind CSS -->
    {{ 'main.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    <!-- Global Noise Overlay (Tactile Digital Paper Grain) -->
    <div class="pitwall-grain-container" aria-hidden="true">
      <svg class="pitwall-grain-svg" xmlns="http://www.w3.org/2000/svg">
        <filter id="pitwall-noise">
          <feTurbulence 
            type="fractalNoise" 
            baseFrequency="0.85" 
            numOctaves="4" 
            stitchTiles="stitch" 
          />
        </filter>
        <rect width="100%" height="100%" filter="url(#pitwall-noise)" />
      </svg>
    </div>

    <!-- Global Navigation Header -->
    <header class="nav-header">
      <div class="nav-grid">
        <button id="menu-trigger-btn" class="nav-menu-btn" aria-label="Toggle menu">MENU</button>
        <a href="/" class="nav-logo-link">
          <img src="{{ 'emblem.png' | asset_url }}" alt="PITWALL" class="nav-logo-img" />
        </a>
        <button class="nav-cart-btn pw-nav-cart-btn" id="pw-cart-open-btn" aria-label="Open cart drawer">
          CART <span class="nav-cart-badge">[ <span id="cart-counter-display">0</span> ]</span>
        </button>
      </div>
    </header>

    <!-- Global Takeover Menu Overlay -->
    <div id="full-menu-overlay" class="menu-overlay">
      <div class="menu-content">
        <ul class="menu-links-list">
          <li class="menu-link-item {% if template == 'index' %}is-active{% endif %}">
            <svg class="menu-bullet-svg" viewBox="0 0 10 10" style="width: 10px; height: 10px; fill: var(--accent); margin-right: 16px;"><rect width="10" height="10"/></svg>
            <a href="/" class="menu-link">HOME</a>
          </li>
          <li class="menu-link-item {% if template contains 'collection' %}is-active{% endif %}">
            <svg class="menu-bullet-svg" viewBox="0 0 10 10" style="width: 10px; height: 10px; fill: var(--accent); margin-right: 16px;"><rect width="10" height="10"/></svg>
            <a href="/pages/collections" class="menu-link">COLLECTIONS</a>
          </li>
          <li class="menu-link-item {% if template == 'page' and page.handle == 'about' %}is-active{% endif %}">
            <svg class="menu-bullet-svg" viewBox="0 0 10 10" style="width: 10px; height: 10px; fill: var(--accent); margin-right: 16px;"><rect width="10" height="10"/></svg>
            <a href="/pages/about" class="menu-link">ABOUT</a>
          </li>
          <li class="menu-link-item">
            <svg class="menu-bullet-svg" viewBox="0 0 10 10" style="width: 10px; height: 10px; fill: var(--accent); margin-right: 16px;"><rect width="10" height="10"/></svg>
            <a href="/pages/contact" class="menu-link" onclick="document.getElementById('full-menu-overlay').classList.remove('is-active'); document.body.style.overflow = '';">CONTACT</a>
          </li>
        </ul>
        <div class="menu-contact-col">
          <span class="menu-contact-label">COMMUNICATIONS</span>
          <div class="menu-contact-details">
            INFO@PITWALL.STUDIO<br>
            @PITWALL.STUDIO
          </div>
        </div>
        <div class="menu-images-col">
          <div class="menu-image-panel">
            <div class="menu-img-placeholder"></div>
            <span class="menu-img-caption">ABOUT THE BRAND</span>
          </div>
          <div class="menu-image-panel">
            <div class="menu-img-placeholder" style="background-color: var(--surface-2);"></div>
            <span class="menu-img-caption">LATEST DROP</span>
          </div>
        </div>
      </div>
      <!-- Bottom telemetry status bar -->
      <div class="menu-bottom-bar">
        <span style="font-family: var(--font-mono); font-size: 11px; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase;">
          [ STATUS: ONLINE ] &nbsp;·&nbsp; [ NEXT DROP: UPCOMING ] &nbsp;·&nbsp; [ EDITION: 01/100 ]
        </span>
      </div>
    </div>

    <!-- Shopify Core Layout Mount -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Global Brutalist Footer -->
    <footer class="footer-section" id="footer">
      <div class="footer-columns scroll-reveal">
        <!-- Left Column (40%) -->
        <div class="footer-left">
          <h2 class="footer-tagline">Precision objects for the ones who notice.</h2>
          <button class="footer-shop-btn" onclick="location.href='/pages/collections'">SHOP NOW</button>
          
          <div class="footer-social-row">
            <a href="#" class="footer-social-link" aria-label="Instagram">
              <svg class="footer-social-svg" viewBox="0 0 24 24" style="width: 20px; height: 20px; fill: currentColor;">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
            </a>
          </div>
        </div>
 
        <!-- Right Column (60%) -->
        <div class="footer-right">
          <a href="/pages/collections" class="footer-nav-link">Collections</a>
          <a href="/pages/about" class="footer-nav-link">About</a>
          <a href="/pages/contact" class="footer-nav-link">Contact</a>
        </div>
      </div>

      <!-- Bottom legal bar -->
      <div class="footer-bottom-bar">
        <span class="footer-legal-text">© 2026 PITWALL. ALL RIGHTS RESERVED.</span>
        <span class="footer-legal-text">PRIVACY · TERMS</span>
      </div>

      <!-- Brand Wordmark Footer Image -->
      <div class="footer-wordmark-container">
        <img src="{{ 'wordmark-footer.png' | asset_url }}" alt="PITWALL" class="footer-wordmark-img" />
      </div>
    </footer>

    <!-- Cart Drawer -->
    <div id="pw-cart-backdrop" class="pw-cart-backdrop" aria-hidden="true"></div>
    <div id="pw-cart-drawer" class="pw-cart-drawer" role="dialog" aria-modal="true" aria-label="Cart">
      <div class="pw-cart-drawer-header">
        <span class="pw-cart-drawer-title">CART</span>
        <button id="pw-cart-close-btn" class="pw-cart-close-btn" aria-label="Close cart">✕</button>
      </div>
      <div id="pw-cart-items" class="pw-cart-items"></div>
      <div id="pw-cart-footer" class="pw-cart-footer" style="display:none;">
        <div class="pw-cart-subtotal">
          <span class="pw-cart-subtotal-label">SUBTOTAL</span>
          <span id="pw-cart-subtotal-value" class="pw-cart-subtotal-value"></span>
        </div>
        <a href="/checkout" class="pw-cart-checkout-btn">CHECKOUT →</a>
      </div>
      <div id="pw-cart-empty" class="pw-cart-empty">
        <p>Your cart is empty.</p>
        <a href="/pages/collections" class="pw-cart-browse-link">BROWSE COLLECTION →</a>
      </div>
    </div>

    <script>
    (function() {
      var openBtn = document.getElementById('pw-cart-open-btn');
      var closeBtn = document.getElementById('pw-cart-close-btn');
      var backdrop = document.getElementById('pw-cart-backdrop');
      var drawer = document.getElementById('pw-cart-drawer');
      var counter = document.getElementById('cart-counter-display');

      function openCart() {
        refreshCart();
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function closeCart() {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      function formatMoney(cents) {
        return '₹' + (cents / 100).toLocaleString('en-IN');
      }

      function refreshCart() {
        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var count = cart.item_count || 0;
            counter.textContent = count;

            var itemsEl = document.getElementById('pw-cart-items');
            var footerEl = document.getElementById('pw-cart-footer');
            var emptyEl = document.getElementById('pw-cart-empty');
            var subtotalEl = document.getElementById('pw-cart-subtotal-value');

            if (count === 0) {
              itemsEl.innerHTML = '';
              footerEl.style.display = 'none';
              emptyEl.style.display = 'block';
            } else {
              emptyEl.style.display = 'none';
              footerEl.style.display = 'block';
              subtotalEl.textContent = formatMoney(cart.total_price);

              itemsEl.innerHTML = cart.items.map(function(item) {
                return '<div class="pw-cart-item">' +
                  '<div class="pw-cart-item-img-wrap">' +
                    (item.image ? '<img src="' + item.image + '" alt="' + item.title + '" class="pw-cart-item-img" />' : '<div class="pw-cart-item-img-placeholder"></div>') +
                  '</div>' +
                  '<div class="pw-cart-item-info">' +
                    '<span class="pw-cart-item-title">' + item.product_title + '</span>' +
                    (item.variant_title && item.variant_title !== 'Default Title' ? '<span class="pw-cart-item-variant">' + item.variant_title + '</span>' : '') +
                    '<div class="pw-cart-item-row">' +
                      '<span class="pw-cart-item-qty">QTY: ' + item.quantity + '</span>' +
                      '<span class="pw-cart-item-price">' + formatMoney(item.line_price) + '</span>' +
                    '</div>' +
                  '</div>' +
                '</div>';
              }).join('');
            }
          });
      }

      if (openBtn) openBtn.addEventListener('click', openCart);
      if (closeBtn) closeBtn.addEventListener('click', closeCart);
      if (backdrop) backdrop.addEventListener('click', closeCart);

      // Refresh count on page load
      fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
        if (counter) counter.textContent = cart.item_count || 0;
      });

      // Listen for Shopify cart updates
      document.addEventListener('cart:refresh', refreshCart);
    })();
    </script>

    <!-- Bundled React + Three.js components -->
    {{ 'pitwall-interactive.js' | asset_url | script_tag }}
  </body>
</html>
