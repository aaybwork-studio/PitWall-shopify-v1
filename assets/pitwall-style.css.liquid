@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;600&family=IBM+Plex+Mono:wght@400;600&family=Syne:wght@700;800&family=Space+Grotesk:wght@700&display=swap');

@font-face {
  font-family: 'btseps2';
  src: url('{{ "btseps2.ttf" | asset_url }}') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Petit Formal Script';
  src: url('{{ "PetitFormalScript-Regular.ttf" | asset_url }}') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

/* Inverted Color Tokens */
:root {
  --bg: #EDEBE5;      /* Warm Off-White */
  --fg: #0C0C0C;      /* Carbon Black */
  --accent: #F6C917;  /* Racing Yellow */
  --surface: #F5F4F0;   /* Light Surface 1 */
  --surface-2: #E5E3DD; /* Light Surface 2 */
  --border: rgba(12, 12, 12, 0.10); /* Soft Dark Borders */
  --muted: rgba(12, 12, 12, 0.50);  /* Soft Dark Muted Text */
  
  --font-display: 'Syne', sans-serif;
  --font-body: 'Barlow', sans-serif;
  --font-mono: 'IBM Plex Mono', monospace;
  --font-secondary: 'Bulgary Rose', 'Petit Formal Script', cursive;
}

/* Brutalist Base Resets */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 0px !important;
  box-shadow: none !important;
  text-shadow: none !important;
  -webkit-font-smoothing: antialiased;
}

html, body {
  background-color: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  font-weight: 300;
  line-height: 1.65;
  overflow-x: hidden;
  max-width: 100%;
}

/* Scrollbar aesthetics */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: var(--bg);
}
::-webkit-scrollbar-thumb {
  background: var(--surface-2);
  border: 1px solid var(--border);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

/* Grain Overlay */
.pitwall-grain-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  pointer-events: none;
}
.pitwall-grain-svg {
  width: 100%;
  height: 100%;
  opacity: 0.04;
  mix-blend-mode: overlay;
}

/* Utilities */
.font-display-strict {
  font-family: var(--font-display);
}
.font-body-strict {
  font-family: var(--font-body);
}
.font-technical-strict {
  font-family: var(--font-mono);
}

.technical-label {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.display-title {
  font-family: var(--font-display);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 0.88;
  text-transform: uppercase;
}

/* NAVIGATION & MENU OVERLAY */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 64px;
  background-color: var(--fg);
  border-bottom: 1px solid rgba(237, 235, 229, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 300;
  display: flex;
  align-items: center;
  padding: 0 100px;
}

.nav-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  width: 100%;
  align-items: center;
}

.nav-menu-btn {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  color: var(--bg);
  background: transparent;
  border: none;
  cursor: pointer;
  justify-self: start;
  padding: 8px 12px;
  transition: color 200ms ease;
}
.nav-menu-btn:hover {
  color: var(--accent);
}

.nav-logo-link {
  justify-self: center;
  display: flex;
  align-items: center;
}

.nav-cart-btn {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  color: var(--bg);
  background: transparent;
  border: none;
  cursor: pointer;
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  transition: color 200ms ease;
}
.nav-cart-btn:hover {
  color: var(--accent);
}
.nav-cart-badge {
  color: var(--accent);
  font-weight: 600;
  vertical-align: super;
  font-size: 9px;
}

/* Takeover Menu */
.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background-color: var(--surface);
  z-index: 200;
  transform: translateY(-110%);
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), visibility 400ms step-end, opacity 400ms ease;
  padding-top: 80px;
  padding-left: 100px;
  padding-right: 100px;
  padding-bottom: 40px;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.menu-overlay.is-active {
  transform: translateY(0);
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s step-start, opacity 400ms ease;
}

.menu-content {
  display: grid;
  grid-template-columns: 4fr 3fr 3fr;
  gap: 40px;
  margin-top: 40px;
  flex: 1;
}

.menu-links-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.menu-link-item {
  display: flex;
  align-items: center;
  gap: 16px;
}

.menu-link {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 64px;
  line-height: 1.25;
  text-transform: uppercase;
  color: var(--fg);
  text-decoration: none;
  transition: color 200ms ease, transform 200ms ease;
  display: inline-block;
}
.menu-link:hover {
  color: var(--accent);
  transform: translateX(8px);
}

.menu-contact-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.menu-contact-label {
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.menu-contact-details {
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 2;
  color: var(--muted);
}

.menu-images-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.menu-img-placeholder {
  aspect-ratio: 16/9;
  background-color: var(--surface-2);
  width: 100%;
  border: 1px solid var(--border);
}

/* HERO SECTION */
.hero-section {
  position: relative;
  height: 100svh;
  background-color: transparent;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  border-bottom: 1px solid var(--border);
}

.hero-video-container {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.hero-video-fallback {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(135deg, #0C0C0C, #181818, #0C0C0C, #1A1A1A, #0C0C0C);
  background-size: 400% 400%;
  animation: diagonal-flow 12s ease infinite;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(12, 12, 12, 0.15);
  z-index: 3;
  pointer-events: none;
}

.hero-logo-wrapper {
  position: absolute;
  left: 100px;
  bottom: 75px;
  z-index: 10;
  mix-blend-mode: difference;
  color: var(--bg);
  pointer-events: none;
}

.hero-title {
  font-family: 'Bulgary Rose', 'Petit Formal Script', cursive;
  font-size: 180px;
  font-weight: normal;
  line-height: 0.85;
  margin: 0;
  letter-spacing: -0.01em;
}

/* UNIVERSAL MUTE BUTTON */
.universal-mute-btn {
  position: fixed;
  bottom: 32px;
  right: 32px;
  z-index: 9999;
  display: flex;
  align-items: center;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  height: 44px;
  font-family: var(--font-mono);
}

.mute-icon-box {
  width: 44px;
  height: 44px;
  background-color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bg);
}

.mute-text-box {
  height: 44px;
  background-color: var(--fg);
  color: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 0;
  opacity: 0;
  overflow: hidden;
  white-space: nowrap;
  transition: max-width 0.4s ease, opacity 0.3s ease;
  padding: 0;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
}

.universal-mute-btn:hover .mute-text-box {
  max-width: 120px;
  opacity: 1;
  padding: 0 16px 0 12px;
  background-color: var(--accent);
  color: var(--fg);
}

/* PRODUCT DETAIL SECTION */
.product-track-wrapper {
  display: grid;
  grid-template-columns: 3fr 2fr;
  min-height: 100vh;
  background-color: var(--bg);
  position: relative;
  z-index: 10;
  padding-top: 64px; /* offset header */
}

.product-canvas-container {
  position: sticky;
  top: 64px;
  height: calc(100vh - 64px);
  background-color: var(--surface);
  border-right: 1px solid var(--border);
  overflow: hidden;
}

.product-canvas-mount {
  width: 100%;
  height: 100%;
}

.product-details-container {
  padding: 80px 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 32px;
}

.product-description {
  font-size: 16px;
  color: var(--muted);
  line-height: 1.8;
}

.product-variants-box {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.variant-select {
  width: 100%;
  padding: 16px;
  font-family: var(--font-mono);
  font-size: 14px;
  background-color: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--fg);
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}

.specs-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 16px;
}

.specs-table tr {
  border-bottom: 1px solid var(--border);
}

.specs-table td {
  padding: 16px 0;
  font-size: 14px;
}

.specs-table td:last-child {
  text-align: right;
  font-family: var(--font-mono);
  font-weight: 600;
}

.btn-primary {
  width: 100%;
  padding: 20px;
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 600;
  background-color: var(--fg);
  color: var(--bg);
  border: 1px solid var(--fg);
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: background-color 200ms ease, color 200ms ease;
}

.btn-primary:hover {
  background-color: var(--accent);
  color: var(--fg);
  border-color: var(--accent);
}

/* SECTION 3 - MARQUEE / TICKER */
.ticker-bar {
  background-color: var(--accent);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 15px 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  width: 100%;
  position: relative;
  z-index: 10;
}

.ticker-track {
  display: flex;
  white-space: nowrap;
  animation: marquee-left 26s linear infinite;
}

.ticker-item-1 {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 12px;
  color: var(--fg);
  letter-spacing: 0.25em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  white-space: nowrap;
  padding-right: 32px;
}

.ticker-sep-1 {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--fg);
  font-weight: 400;
  margin-left: 32px;
  letter-spacing: normal;
}

@keyframes marquee-left {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@keyframes diagonal-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* SECTION 4 - PRODUCT SHOWCASE */
.showcase-section {
  background-color: transparent;
  padding: 80px 100px 100px;
  border-bottom: 1px solid var(--border);
  position: relative;
  z-index: 10;
}

.showcase-header {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 64px;
}

.showcase-label {
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 15.4px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.showcase-divider {
  height: 1px;
  background-color: var(--border);
  width: 100%;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  column-gap: 40px;
  row-gap: 120px;
}

.product-card {
  display: flex;
  flex-direction: column;
  position: relative;
  width: 90%;
  text-decoration: none;
  color: inherit;
}

.product-a {
  grid-column: 1 / 8;
  justify-self: start;
}
.product-b {
  grid-column: 8 / 13;
  margin-top: 120px;
  justify-self: end;
}
.product-c {
  grid-column: 1 / 6;
  margin-top: 80px;
  justify-self: start;
}
.product-d {
  grid-column: 6 / 13;
  justify-self: end;
}
.product-e {
  grid-column: 1 / 7;
  margin-top: 100px;
  justify-self: start;
}
.product-f {
  grid-column: 7 / 13;
  margin-top: 60px;
  justify-self: end;
}
.product-g {
  grid-column: 2 / 8;
  margin-top: 80px;
  justify-self: center;
}

.product-image-container {
  position: relative;
  width: 100%;
  overflow: hidden;
  background-color: transparent;
  border: none;
}

.product-a .product-image-container,
.product-d .product-image-container,
.product-e .product-image-container,
.product-g .product-image-container {
  aspect-ratio: 4/5;
}

.product-b .product-image-container,
.product-c .product-image-container,
.product-f .product-image-container {
  aspect-ratio: 3/4;
}

.product-sketch-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.65;
  transition: opacity 300ms ease;
}

.product-card:hover .product-sketch-overlay {
  opacity: 0.9;
}

.product-img-element {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 400ms ease;
}

.product-card:hover .product-img-element {
  transform: scale(1.03);
}

.product-hover-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #0C0C0C;
  padding: 20px 24px;
  transform: translateY(100%);
  transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.product-card:hover .product-hover-info {
  transform: translateY(0);
}

.product-hover-title {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: #EDEBE5;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.product-hover-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid rgba(237, 235, 229, 0.15);
  padding-top: 8px;
}

.product-hover-specs {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.08em;
  color: rgba(237, 235, 229, 0.45);
  text-transform: uppercase;
}

.product-hover-price {
  font-family: var(--font-mono);
  font-size: 13px;
  color: #F6C917;
  font-weight: 600;
}

/* SECTION 5 - MANIFESTO */
.manifesto-section {
  background: rgba(237, 235, 229, 0.55);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  border: 1px solid var(--fg);
  margin: 60px auto;
  max-width: 1080px;
  width: calc(100% - 200px);
  padding: 52px 64px;
  display: flex;
  flex-direction: column;
  gap: 28px;
  position: relative;
  z-index: 10;
}

.manifesto-header-row {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.manifesto-label {
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 15.4px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.manifesto-line-border {
  height: 1px;
  background-color: var(--border);
  width: 100%;
}

.manifesto-headline {
  font-family: var(--font-display);
  font-weight: 800;
  color: var(--fg);
  text-transform: uppercase;
  letter-spacing: -0.03em;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.manifesto-line-small {
  font-size: clamp(16px, 1.6vw, 22px);
  line-height: 1.1;
  opacity: 0.75;
}

.manifesto-line-large {
  font-size: clamp(32px, 4.6vw, 60px);
  line-height: 0.95;
}

/* SECTION 7 - ABOUT STRIP */
.about-strip-section {
  background-color: transparent;
  padding: 120px 100px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  border-bottom: 1px solid var(--border);
  position: relative;
  z-index: 10;
}

.about-left {
  background: rgba(237, 235, 229, 0.55);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  border: 1px solid var(--fg);
  padding: 48px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
}

.about-label {
  font-family: var(--font-mono);
  font-size: 15.4px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 24px;
}

.about-headline {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(32px, 4vw, 56px);
  line-height: 0.95;
  letter-spacing: -0.03em;
  color: var(--fg);
  text-transform: uppercase;
  margin-bottom: 32px;
}

.about-body {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 15px;
  line-height: 1.7;
  color: var(--muted);
  max-width: 480px;
  margin-bottom: 40px;
}

.about-btn {
  border: 1px solid var(--fg);
  background: transparent;
  color: var(--fg);
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 14px 28px;
  cursor: pointer;
  transition: background-color 200ms ease, color 200ms ease;
}

.about-btn:hover {
  background-color: var(--fg);
  color: var(--bg);
}

.about-right {
  width: 100%;
}

.about-img-placeholder {
  aspect-ratio: 4/5;
  background: rgba(237, 235, 229, 0.35);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  width: 100%;
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* SECTION 8 - FOOTER */
.footer-section {
  background-color: var(--accent);
  color: var(--fg);
  padding: 72px 100px 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  z-index: 10;
}

.footer-columns {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 64px;
}

.footer-left {
  width: 40%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.footer-tagline {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(18px, 2vw, 26px);
  line-height: 1.3;
  color: var(--fg);
  margin-bottom: 24px;
}

.footer-shop-btn {
  background-color: var(--fg);
  color: var(--bg);
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 14px 28px;
  border: none;
  cursor: pointer;
  margin-bottom: 40px;
  transition: background-color 150ms ease;
}

.footer-shop-btn:hover {
  background-color: var(--surface-2);
  color: var(--fg);
}

.footer-social-row {
  display: flex;
  gap: 16px;
}

.footer-social-link {
  color: var(--fg);
  transition: opacity 150ms ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-social-link:hover {
  opacity: 0.6;
}

.footer-social-svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
}

.footer-right {
  width: 60%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-nav-link {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(28px, 4vw, 52px);
  line-height: 1.0;
  color: var(--fg);
  text-transform: uppercase;
  text-decoration: none;
  letter-spacing: -0.03em;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(12, 12, 12, 0.2);
  transition: color 150ms ease;
}

.footer-nav-link:hover {
  color: rgba(12, 12, 12, 0.5);
}

.footer-bottom-bar {
  background-color: rgba(12, 12, 12, 0.12);
  padding: 16px 100px;
  margin-top: 64px;
  margin-left: -100px;
  margin-right: -100px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-legal-text {
  font-family: var(--font-mono);
  font-size: 10px;
  color: rgba(12, 12, 12, 0.6);
  letter-spacing: 0.08em;
}

.footer-ghost-container {
  width: 100%;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24px 0 12px;
}

.footer-ghost-text {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(80px, 14vw, 200px);
  line-height: 0.85;
  text-transform: uppercase;
  letter-spacing: -0.04em;
  color: rgba(12, 12, 12, 0.08);
  user-select: none;
  white-space: nowrap;
}

/* RESPONSIVE MEDIA QUERIES */
@media (max-width: 767px) {
  .nav-header {
    padding: 0 20px;
  }

  .menu-overlay {
    padding-top: 96px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .menu-content {
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 20px;
  }

  .menu-link {
    font-size: 48px;
  }

  .menu-images-col {
    display: none;
  }

  .hero-logo-wrapper {
    left: 20px;
    bottom: 40px;
  }
  
  .hero-title {
    font-size: clamp(48px, 12vw, 96px);
  }

  .universal-mute-btn {
    bottom: 24px;
    right: 24px;
  }

  .product-grid {
    grid-template-columns: 1fr;
    row-gap: 60px;
  }

  .product-card {
    grid-column: 1 / -1 !important;
    margin-top: 0 !important;
    width: 100%;
  }

  .manifesto-section {
    gap: 24px;
    padding: 36px 24px;
    margin: 24px auto;
    width: calc(100% - 40px);
    background: rgba(237, 235, 229, 0.88);
  }

  .about-strip-section {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 60px 20px;
  }

  .about-left {
    padding: 32px 20px;
    background: rgba(237, 235, 229, 0.88);
  }

  .footer-columns {
    flex-direction: column;
    gap: 48px;
  }

  .footer-left, .footer-right {
    width: 100%;
  }

  .footer-section {
    padding: 48px 20px 0;
  }

  .footer-bottom-bar {
    flex-direction: column;
    gap: 16px;
    text-align: center;
    margin-left: -20px;
    margin-right: -20px;
    padding: 24px 20px;
  }

  .footer-wordmark-container {
    width: calc(100% + 40px);
    margin-left: -20px;
    margin-right: -20px;
  }
}

/* Pitwall Brand Styling Additions */
.nav-logo-img {
  height: 31px;
  width: auto;
  display: block;
}

.menu-link-item .menu-bullet-svg {
  display: none;
  vertical-align: middle;
}

.menu-link-item.is-active .menu-link {
  color: var(--accent) !important;
}

.menu-link-item.is-active .menu-bullet-svg {
  display: inline-block !important;
}

.menu-img-caption {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted);
  text-transform: uppercase;
  margin-top: 8px;
  display: block;
}

.menu-bottom-bar {
  margin-top: auto;
  border-top: 1px solid var(--border);
  padding-top: 24px;
  display: flex;
  justify-content: center;
  width: 100%;
}

.footer-wordmark-container {
  width: calc(100% + 200px);
  margin-left: -100px;
  margin-right: -100px;
  display: flex;
  justify-content: center;
  padding: 24px 0 0;
  overflow: hidden;
}

.footer-wordmark-img {
  width: 85%;
  height: auto;
  display: block;
}
