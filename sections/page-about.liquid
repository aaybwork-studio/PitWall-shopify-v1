<!-- PITWALL ABOUT PAGE SECTION -->
<style>
  .pw-about-section {
    width: 100%;
    min-height: calc(100vh - 64px);
    background-color: var(--bg);
    color: var(--fg);
    position: relative;
    overflow: hidden;
    padding: 120px 100px;
    z-index: 10;
  }

  .pw-about-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 80px;
    row-gap: 60px;
    align-items: start;
    position: relative;
    z-index: 10;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Left Column: Image */
  .pw-about-image-col {
    grid-column: 1 / 6;
    width: 100%;
  }

  .pw-about-image-container {
    width: 100%;
    aspect-ratio: 3/4;
    border: 1px solid var(--fg);
    overflow: hidden;
    background-color: var(--surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pw-about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 300ms ease;
  }
  .pw-about-image:hover {
    filter: grayscale(0%);
  }

  .pw-about-svg-fallback {
    width: 80%;
    height: 80%;
    opacity: 0.15;
    stroke: var(--fg);
    fill: none;
    stroke-width: 0.8;
  }

  /* Right Column: Editorial Stack */
  .pw-about-content-col {
    grid-column: 6 / 13;
    display: flex;
    flex-direction: column;
    gap: 72px;
    position: relative;
  }

  .pw-about-stack {
    border-top: 1px solid var(--fg);
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pw-about-technical-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--fg);
    text-transform: uppercase;
  }

  .pw-about-headline {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.2vw, 48px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .pw-about-body {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--fg);
    opacity: 0.85;
  }
  .pw-about-body p {
    margin-bottom: 16px;
  }

  /* Credits Sub-grid */
  .pw-about-credits-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    width: 100%;
  }

  .pw-about-credit-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pw-about-credit-role {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--fg);
    opacity: 0.5;
    text-transform: uppercase;
  }

  .pw-about-credit-name {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Contact Outbound Links */
  .pw-about-contact-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pw-about-contact-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(12, 12, 12, 0.15);
    padding-bottom: 12px;
    text-decoration: none;
    color: var(--fg);
    transition: color 200ms ease;
  }

  .pw-about-contact-row:hover {
    color: var(--accent);
  }

  .pw-about-contact-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pw-about-contact-value {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* Faded Background Wordmark */
  .pw-about-watermark {
    position: absolute;
    bottom: -60px;
    right: -40px;
    font-family: var(--font-branding, 'BTSE PS2', sans-serif);
    font-size: 14vw;
    font-weight: 800;
    line-height: 0.8;
    color: var(--fg);
    opacity: 0.03;
    z-index: 1;
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  /* Responsive styling */
  @media screen and (max-width: 1024px) {
    .pw-about-section {
      padding: 100px 48px;
    }
    .pw-about-grid {
      column-gap: 40px;
    }
  }

  @media screen and (max-width: 767px) {
    .pw-about-section {
      padding: 80px 20px 60px 20px;
    }
    .pw-about-grid {
      grid-template-columns: 1fr;
      row-gap: 48px;
    }
    .pw-about-image-col {
      grid-column: 1;
    }
    .pw-about-content-col {
      grid-column: 1;
      gap: 56px;
    }
    .pw-about-credits-list {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .pw-about-watermark {
      font-size: 20vw;
      bottom: -30px;
      right: -20px;
    }
  }
</style>

<section class="pw-about-section">
  <!-- Asymmetric brutalist layout container -->
  <div class="pw-about-grid">
    
    <!-- Left Column: Image wrapper -->
    <div class="pw-about-image-col">
      <div class="pw-about-image-container">
        {% if section.settings.feature_image != blank %}
          <img 
            class="pw-about-image" 
            src="{{ section.settings.feature_image | image_url: width: 1200 }}" 
            alt="{{ section.settings.feature_image.alt | default: 'Pitwall chassis grid' }}"
            loading="lazy"
          >
        {% else %}
          <!-- Responsive grid lines background vector fallback if no image provided -->
          <svg class="pw-about-svg-fallback" viewBox="0 0 400 500">
            <path d="M 0 50 H 400 M 0 100 H 400 M 0 150 H 400 M 0 200 H 400 M 0 250 H 400 M 0 300 H 400 M 0 350 H 400 M 0 400 H 400 M 0 450 H 400" />
            <path d="M 50 0 V 500 M 100 0 V 500 M 150 0 V 500 M 200 0 V 500 M 250 0 V 500 M 300 0 V 500 M 350 0 V 500" />
            <path d="M 50 150 L 150 300 L 250 200 L 350 400" stroke="#F6C917" stroke-width="2.5" />
          </svg>
        {% endif %}
      </div>
    </div>

    <!-- Right Column: Context stack -->
    <div class="pw-about-content-col">
      
      <!-- STACK 01: ABOUT -->
      <div class="pw-about-stack">
        <span class="pw-about-technical-label">// 01 ABOUT</span>
        <h2 class="pw-about-headline">{{ section.settings.about_title }}</h2>
        <div class="pw-about-body">
          {{ section.settings.about_description }}
        </div>
      </div>

      <!-- STACK 02: CREDIT SYSTEM -->
      <div class="pw-about-stack">
        <span class="pw-about-technical-label">// 02 {{ section.settings.credits_title }}</span>
        <div class="pw-about-credits-list">
          {% for block in section.blocks %}
            {% if block.type == 'credit_item' %}
              <div class="pw-about-credit-item" {{ block.shopify_attributes }}>
                <span class="pw-about-credit-role">{{ block.settings.role }}</span>
                <span class="pw-about-credit-name">{{ block.settings.name }}</span>
              </div>
            {% endif %}
          {% else %}
            <!-- Default placeholder credits if none added via merchant dashboard -->
            <div class="pw-about-credit-item">
              <span class="pw-about-credit-role">CREATIVE & ART DIRECTION</span>
              <span class="pw-about-credit-name">AAYBWORK STUDIO</span>
            </div>
            <div class="pw-about-credit-item">
              <span class="pw-about-credit-role">TECHNICAL INFRASTRUCTURE</span>
              <span class="pw-about-credit-name">PITWALL ENG DEV-01</span>
            </div>
            <div class="pw-about-credit-item">
              <span class="pw-about-credit-role">PRODUCTION & LOGISTICS</span>
              <span class="pw-about-credit-name">CHASSIS PREVIEW LAB</span>
            </div>
            <div class="pw-about-credit-item">
              <span class="pw-about-credit-role">TYPOGRAPHY PARTNERS</span>
              <span class="pw-about-credit-name">SYNE / BARLOW / IBM</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- STACK 03: CONTACTS -->
      <div class="pw-about-stack">
        <span class="pw-about-technical-label">// 03 {{ section.settings.contact_title }}</span>
        <div class="pw-about-contact-details">
          {% if section.settings.email_address != blank %}
            <a href="mailto:{{ section.settings.email_address }}" class="pw-about-contact-row">
              <span class="pw-about-contact-title">EMAIL DIRECT</span>
              <span class="pw-about-contact-value">{{ section.settings.email_address | upcase }}</span>
            </a>
          {% endif %}
          {% if section.settings.instagram_handle != blank %}
            <a href="https://instagram.com/{{ section.settings.instagram_handle | replace: '@', '' }}" class="pw-about-contact-row" target="_blank" rel="noopener">
              <span class="pw-about-contact-title">INSTAGRAM FEED</span>
              <span class="pw-about-contact-value">{{ section.settings.instagram_handle | upcase }}</span>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Massive Faded Background Watermark -->
      {% if section.settings.watermark_text != blank %}
        <div class="pw-about-watermark">
          {{ section.settings.watermark_text }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Grid Editorial",
  "settings": [
    {
      "type": "header",
      "content": "Visual Assets"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Left Column Feature Image",
      "info": "Should be a 3:4 portrait aspect ratio for best visual alignment."
    },
    {
      "type": "text",
      "id": "watermark_text",
      "label": "Faded Background Watermark",
      "default": "PITWALL"
    },
    {
      "type": "header",
      "content": "Stack 1: About Narrative"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "Headline Text",
      "default": "PRECISION MERCHANDISE FOR THE RULING CLASS"
    },
    {
      "type": "richtext",
      "id": "about_description",
      "label": "Narrative Paragraphs",
      "default": "<p>PITWALL is an India-first F1 collectibles brand for fans who understand the sport at the level of the pitwall. Not the grandstand. The wall. Where every object we make is held to the same standard as the machines we obsess over.</p><p>We design precision instruments, apparel, and structural art for enthusiasts who appreciate high performance, mathematical limits, and technical racing execution.</p>"
    },
    {
      "type": "header",
      "content": "Stack 2: Credits Configuration"
    },
    {
      "type": "text",
      "id": "credits_title",
      "label": "Credits Column Header",
      "default": "CONTRIBUTORS"
    },
    {
      "type": "header",
      "content": "Stack 3: Contact & Outreach"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact Column Header",
      "default": "COMMUNICATIONS"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Contact Email",
      "default": "info@pitwall.studio"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Username",
      "default": "@pitwall.studio"
    }
  ],
  "blocks": [
    {
      "type": "credit_item",
      "name": "Credit Entry",
      "settings": [
        {
          "type": "text",
          "id": "role",
          "label": "Role / Category",
          "default": "CREATIVE DIRECTION"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Contributor Name",
          "default": "PITWALL STUDIO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Grid Editorial",
      "blocks": [
        {
          "type": "credit_item",
          "settings": {
            "role": "CREATIVE & ART DIRECTION",
            "name": "AAYBWORK STUDIO"
          }
        },
        {
          "type": "credit_item",
          "settings": {
            "role": "TECHNICAL INFRASTRUCTURE",
            "name": "PITWALL ENG DEV-01"
          }
        },
        {
          "type": "credit_item",
          "settings": {
            "role": "PRODUCTION & LOGISTICS",
            "name": "CHASSIS PREVIEW LAB"
          }
        },
        {
          "type": "credit_item",
          "settings": {
            "role": "TYPOGRAPHY PARTNERS",
            "name": "SYNE / BARLOW / IBM"
          }
        }
      ]
    }
  ]
}
{% endschema %}
