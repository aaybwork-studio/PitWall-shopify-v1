<!-- PITWALL COMBINED CATALOG & COLLECTIONS PAGE -->
<style>
  .pw-combined-section {
    background-color: var(--bg);
    padding: 80px 0 120px;
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: calc(100vh - 64px);
  }

  /* Collections Section */
  .pw-colls-container {
    padding: 0 100px 60px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .pw-colls-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 6.5vw, 96px);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 0.9;
    text-transform: uppercase;
    margin-bottom: 50px;
    color: var(--fg);
  }

  /* Horizontal scrolling collections layout */
  .pw-colls-row {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding-bottom: 24px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .pw-colls-row::-webkit-scrollbar {
    height: 6px;
  }
  .pw-colls-row::-webkit-scrollbar-track {
    background: rgba(12, 12, 12, 0.05);
  }
  .pw-colls-row::-webkit-scrollbar-thumb {
    background: rgba(12, 12, 12, 0.2);
  }

  .pw-coll-card {
    flex: 0 0 280px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    opacity: 0;
    transform: translateX(40px);
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), 
                transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    color: inherit;
  }

  .pw-coll-card.reveal-active {
    opacity: 1;
    transform: translateX(0);
  }

  .pw-coll-img-wrapper {
    aspect-ratio: 4/5;
    width: 100%;
    border: 1px solid rgba(12, 12, 12, 0.15);
    overflow: hidden;
    background-color: var(--surface);
  }

  .pw-coll-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .pw-coll-card:hover .pw-coll-img {
    transform: scale(1.05);
  }

  .pw-coll-name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
  }

  /* Section Breaker: Double-lined filters and sort */
  .pw-breaker-bar {
    border-top: 1px solid rgba(12, 12, 12, 0.15);
    border-bottom: 1px solid rgba(12, 12, 12, 0.15);
    padding: 16px 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--bg);
    width: 100%;
  }

  .pw-dropdown-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    border: none;
    color: var(--fg);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0;
  }
  
  .pw-dropdown-btn:hover {
    color: var(--accent);
  }

  /* Shop Section */
  .pw-shop-section {
    padding: 80px 100px 0;
    max-width: 1440px;
    margin: 0 auto;
  }

  .pw-shop-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 48px;
    color: var(--fg);
  }

  /* 3-Column Clean Products Grid */
  .pw-shop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 40px;
    row-gap: 80px;
    width: 100%;
  }

  .pw-shop-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .pw-reveal-item {
    opacity: 0;
    transform: translateY(48px);
    transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1), 
                transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pw-reveal-item.reveal-active {
    opacity: 1;
    transform: translateY(0);
  }

  .pw-shop-img-wrapper {
    aspect-ratio: 4/5;
    width: 100%;
    border: 1px solid rgba(12, 12, 12, 0.08);
    overflow: hidden;
    background-color: #FFFFFF;
    margin-bottom: 20px;
  }

  .pw-shop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pw-shop-card:hover .pw-shop-img {
    transform: scale(1.03);
  }

  .pw-shop-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(12, 12, 12, 0.1);
  }

  .pw-shop-card:hover .pw-shop-info {
    border-color: var(--fg);
  }

  .pw-shop-name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg);
  }

  .pw-shop-price {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg);
  }

  .pw-shop-meta {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(12, 12, 12, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Responsive layouts */
  @media screen and (max-width: 1024px) {
    .pw-colls-container, .pw-breaker-bar, .pw-shop-section {
      padding-left: 48px;
      padding-right: 48px;
    }
    .pw-shop-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 30px;
      row-gap: 60px;
    }
  }

  @media screen and (max-width: 767px) {
    .pw-colls-container, .pw-breaker-bar, .pw-shop-section {
      padding-left: 20px;
      padding-right: 20px;
    }
    .pw-colls-container {
      padding-bottom: 40px;
    }
    .pw-colls-title {
      margin-bottom: 30px;
    }
    .pw-shop-grid {
      grid-template-columns: 1fr;
      row-gap: 48px;
    }
  }
</style>

