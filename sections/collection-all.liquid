<script>
  function initAnimations() {
    // 1. Immediately activate collections reveal animation
    const collCards = document.querySelectorAll('.pw-coll-card');
    collCards.forEach(card => {
      card.classList.add('reveal-active');
    });

    // 2. Setup IntersectionObserver for shop products reveal animation on scroll
    const shopObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-active');
          observer.unobserve(entry.target);
        }
      });
    }, {
      root: null,
      rootMargin: '0px 0px -5% 0px',
      threshold: 0.05
    });

    const shopItems = document.querySelectorAll('.pw-reveal-item');
    shopItems.forEach(item => {
      shopObserver.observe(item);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }

  // Support Shopify Theme Editor live reloading
  document.addEventListener('shopify:section:load', initAnimations);
  document.addEventListener('shopify:section:select', initAnimations);
</script>

