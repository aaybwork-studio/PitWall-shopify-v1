<!-- PITWALL ALL PRODUCTS SHOWCASE CATALOG -->
<style>
  .pw-catalog-section {
    background-color: var(--bg);
    padding: 120px 100px 100px;
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: calc(100vh - 64px);
  }

  /* Top Label Header Row */
  .pw-catalog-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--border);
    padding-bottom: 24px;
    margin-bottom: 80px;
    width: 100%;
  }

  .pw-catalog-main-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--fg);
    margin: 0;
  }

  .pw-catalog-season-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--fg);
    opacity: 0.8;
    text-transform: uppercase;
    padding-bottom: 6px;
  }

  /* Catalog Staggered Grid */
  .pw-catalog-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 40px;
    row-gap: 120px;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .pw-catalog-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 95%;
    text-decoration: none;
    color: inherit;
    transition: transform 300ms ease;
  }

  /* Staggered Column Splitting Rules (A, B, C, D repeats) */
  .pw-catalog-card-a {
    grid-column: 1 / 8;
    justify-self: start;
  }

  .pw-catalog-card-b {
    grid-column: 8 / 13;
    margin-top: 120px;
    justify-self: end;
  }

  .pw-catalog-card-c {
    grid-column: 1 / 6;
    margin-top: 80px;
    justify-self: start;
  }

  .pw-catalog-card-d {
    grid-column: 6 / 13;
    justify-self: end;
  }

  .pw-catalog-img-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--surface-2);
    border: 1px solid var(--border);
  }

  .pw-catalog-card-a .pw-catalog-img-container,
  .pw-catalog-card-d .pw-catalog-img-container {
    aspect-ratio: 4/5;
  }

  .pw-catalog-card-b .pw-catalog-img-container,
  .pw-catalog-card-c .pw-catalog-img-container {
    aspect-ratio: 3/4;
  }

  /* Vector Blueprint fallbacks */
  .pw-catalog-sketch-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
    transition: opacity 300ms ease;
  }

  .pw-catalog-card:hover .pw-catalog-sketch-overlay {
    opacity: 0.9;
  }

  .pw-catalog-img-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform 400ms ease, filter 300ms ease;
  }

  .pw-catalog-card:hover .pw-catalog-img-element {
    transform: scale(1.03);
    filter: grayscale(0%);
  }

  /* Dynamic Slide-Up Bottom Info Panel */
  .pw-catalog-hover-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #0C0C0C;
    padding: 20px 24px;
    transform: translateY(100%);
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid rgba(237, 235, 229, 0.1);
  }

  .pw-catalog-card:hover .pw-catalog-hover-info {
    transform: translateY(0);
  }

  .pw-catalog-hover-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: #EDEBE5;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .pw-catalog-hover-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(237, 235, 229, 0.15);
    padding-top: 8px;
    gap: 12px;
  }

  .pw-catalog-hover-specs {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: rgba(237, 235, 229, 0.45);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pw-catalog-price-container {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .pw-catalog-hover-price {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #F6C917;
    font-weight: 600;
  }

  /* Inline Pre-Order Tag */
  .pw-catalog-preorder-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    color: #F6C917;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Responsive layouts */
  @media screen and (max-width: 1024px) {
    .pw-catalog-section {
      padding: 100px 48px 80px;
    }
    .pw-catalog-grid {
      column-gap: 30px;
      row-gap: 80px;
    }
  }

  @media screen and (max-width: 767px) {
    .pw-catalog-section {
      padding: 80px 20px 60px;
    }
    .pw-catalog-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 48px;
    }
    .pw-catalog-grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
    .pw-catalog-card {
      grid-column: 1 !important;
      margin-top: 0 !important;
      width: 100%;
    }
    .pw-catalog-img-container {
      aspect-ratio: 4/5 !important;
    }
    /* Expose metadata block permanently on mobile since hover hover panel is hard to trigger on mobile tap */
    .pw-catalog-hover-info {
      position: relative;
      transform: translateY(0);
      background-color: transparent;
      padding: 12px 0 0 0;
      border-top: none;
    }
    .pw-catalog-hover-title {
      color: var(--fg);
      font-size: 14px;
    }
    .pw-catalog-hover-specs {
      color: var(--fg);
      opacity: 0.6;
    }
    .pw-catalog-hover-meta {
      border-top: 1px solid rgba(12, 12, 12, 0.1);
      padding-top: 6px;
    }
    .pw-catalog-hover-price {
      color: var(--fg);
      font-weight: 600;
    }
  }
</style>

