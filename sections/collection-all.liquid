{% schema %}
{
  "name": "Product Staggered Catalog",
  "settings": [
    {
      "type": "text",
      "id": "header_title",
      "label": "Section Headline",
      "default": "ALL PRODUCTS"
    },
    {
      "type": "text",
      "id": "season_label",
      "label": "Technical Season Label",
      "default": "[ SEASON-01 / CALIBRATION ]"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max Products Count",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Product Staggered Catalog"
    }
  ]
}
{% endschema %}
