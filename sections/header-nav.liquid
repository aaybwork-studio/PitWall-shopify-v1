<!-- Global Navigation Header -->
<header class="nav-header">
  <div class="nav-grid-new">
    <!-- Mobile Trigger -->
    <button id="menu-trigger-btn-mobile" class="menu-trigger-btn-mobile" aria-label="Toggle menu">MENU</button>

    <!-- Logo (Left) -->
    <a href="/" class="nav-logo-link-new">
      <img src="{{ 'emblem.png' | asset_url }}" alt="PITWALL" class="nav-logo-img-new" />
      <span class="nav-logo-text-new">PITWALL</span>
    </a>

    <!-- Main Navigation Links (Center) -->
    <nav class="nav-menu-desktop">
      <div class="nav-menu-item" data-dropdown="new-arrivals">
        <a href="/collections/all" class="nav-menu-link">NEW ARRIVALS</a>
      </div>
      <div class="nav-menu-item" data-dropdown="drivers">
        <span class="nav-menu-link">DRIVERS</span>
      </div>
      <div class="nav-menu-item" data-dropdown="teams">
        <span class="nav-menu-link">TEAMS</span>
      </div>
      <div class="nav-menu-item" data-dropdown="f1-gifts">
        <span class="nav-menu-link">F1 GIFTS</span>
      </div>
      <div class="nav-menu-item" data-dropdown="categories">
        <span class="nav-menu-link">CATEGORIES</span>
      </div>
    </nav>

    <!-- Right Icons (Right) -->
    <div class="nav-icons-right">
      <!-- Search trigger -->
      <a href="/search" class="nav-icon-btn" aria-label="Search">
        <svg class="nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <!-- Account link -->
      <a href="/account" class="nav-icon-btn" aria-label="Account">
        <svg class="nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <!-- Theme toggle -->
      <button id="theme-toggle-btn" class="nav-icon-btn" aria-label="Toggle theme">
        <svg class="theme-icon-sun nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <circle cx="12" cy="12" r="4"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon-moon nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
      <!-- Cart trigger wrapper with hover dropdown -->
      <div class="nav-cart-wrapper-new">
        <button class="nav-cart-btn-new" id="pw-cart-open-btn" aria-label="Open cart drawer">
          <svg class="nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="nav-cart-badge-count" id="cart-counter-display">0</span>
        </button>

        <!-- Cart Dropdown (Desktop only) -->
        <div id="nav-cart-dropdown" class="nav-cart-dropdown">
          <div id="pw-dropdown-cart-items" class="dropdown-cart-items">
            <!-- Dynamically populated via AJAX refreshCart() -->
          </div>
          <div id="pw-dropdown-cart-footer" class="dropdown-cart-footer">
            <div class="dropdown-cart-subtotal">
              <span>SUBTOTAL</span>
              <span id="pw-dropdown-subtotal-value">₹0.00</span>
            </div>
            <div class="dropdown-cart-actions">
              <a href="/cart" class="dropdown-cart-btn-link dropdown-cart-btn-view">VIEW CART</a>
              <a href="/checkout" class="dropdown-cart-btn-link dropdown-cart-btn-checkout">CHECKOUT</a>
            </div>
          </div>
          <div id="pw-dropdown-cart-empty" class="dropdown-cart-empty">
            <p>Your cart is empty.</p>
            <a href="/collections/all" class="dropdown-cart-browse">BROWSE COLLECTIONS →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Megamenu Dropdown Container -->
  <div id="nav-megamenu-container" class="megamenu-container">
    <!-- DRIVERS DROPDOWN -->
    <div class="megamenu-panel" data-panel="drivers">
      <div class="megamenu-grid-drivers">
        <div class="megamenu-driver-col-active megamenu-grid-drivers-active">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'nav_group' %}
                {% if block.settings.group == 'active' %}
                  <span class="megamenu-group-label">{{ block.settings.label }}</span>
                {% endif %}
              {% when 'driver_item' %}
                {% if block.settings.group == 'active' %}
                  <a href="{{ block.settings.link }}" class="driver-card" {{ block.shopify_attributes }}>
                    <div class="driver-headshot-wrap">
                      <img src="{{ block.settings.headshot | image_url: width: 200 }}" alt="{{ block.settings.driver_name }}" loading="lazy" class="driver-headshot-img" />
                    </div>
                    <span class="driver-card-name">{{ block.settings.driver_name }}</span>
                  </a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
        <div class="megamenu-driver-col-alumni megamenu-grid-drivers-alumni">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'nav_group' %}
                {% if block.settings.group == 'alumni' %}
                  <span class="megamenu-group-label">{{ block.settings.label }}</span>
                {% endif %}
              {% when 'driver_item' %}
                {% if block.settings.group == 'alumni' %}
                  <a href="{{ block.settings.link }}" class="driver-card" {{ block.shopify_attributes }}>
                    <div class="driver-headshot-wrap">
                      <img src="{{ block.settings.headshot | image_url: width: 200 }}" alt="{{ block.settings.driver_name }}" loading="lazy" class="driver-headshot-img" />
                    </div>
                    <span class="driver-card-name">{{ block.settings.driver_name }}</span>
                  </a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- TEAMS DROPDOWN -->
    <div class="megamenu-panel" data-panel="teams">
      <div class="megamenu-grid-teams">
        <div class="megamenu-team-col-current-1">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'nav_group' %}
                {% if block.settings.group == 'current_1' %}
                  <span class="megamenu-group-label">{{ block.settings.label }}</span>
                {% endif %}
              {% when 'team_item' %}
                {% if block.settings.group == 'current_1' %}
                  <a href="{{ block.settings.link }}" class="team-card" {{ block.shopify_attributes }}>
                    <div class="team-car-img-wrap">
                      {{ block.settings.team_image | image_url: width: 400 | image_tag }}
                    </div>
                    <span class="team-card-name">{{ block.settings.team_name }}</span>
                  </a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
        <div class="megamenu-team-col-current-2">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'nav_group' %}
                {% if block.settings.group == 'current_2' %}
                  <span class="megamenu-group-label">{{ block.settings.label }}</span>
                {% endif %}
              {% when 'team_item' %}
                {% if block.settings.group == 'current_2' %}
                  <a href="{{ block.settings.link }}" class="team-card" {{ block.shopify_attributes }}>
                    <div class="team-car-img-wrap">
                      {{ block.settings.team_image | image_url: width: 400 | image_tag }}
                    </div>
                    <span class="team-card-name">{{ block.settings.team_name }}</span>
                  </a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
        <div class="megamenu-team-col-legacy">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'nav_group' %}
                {% if block.settings.group == 'legacy' %}
                  <span class="megamenu-group-label">{{ block.settings.label }}</span>
                {% endif %}
              {% when 'team_item' %}
                {% if block.settings.group == 'legacy' %}
                  <a href="{{ block.settings.link }}" class="team-card" {{ block.shopify_attributes }}>
                    <div class="team-car-img-wrap">
                      {{ block.settings.team_image | image_url: width: 400 | image_tag }}
                    </div>
                    <span class="team-card-name">{{ block.settings.team_name }}</span>
                  </a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- F1 GIFTS DROPDOWN -->
    <div class="megamenu-panel" data-panel="f1-gifts">
      <div class="megamenu-grid-gifts">
        <!-- Column 1: Gift Groups -->
        <div class="megamenu-gift-col">
          <span class="gift-header">RECIPIENT CATEGORY</span>
          <ul class="gift-links-list">
            <li><a href="/collections/desk-accessories">For the Desk</a></li>
            <li><a href="/collections/2d-wall-art">For the Wall</a></li>
            <li><a href="/products/pitwall-gift-card">Gift Cards & Vouchers</a></li>
          </ul>
        </div>
        <!-- Column 2: Price Brackets -->
        <div class="megamenu-gift-col">
          <span class="gift-header">PRICE BRACKETS</span>
          <ul class="gift-links-list">
            <li><a href="/collections/all?price_max=5000">Gifts Under ₹5,000</a></li>
            <li><a href="/collections/all?price_min=5000&price_max=10000">Gifts Under ₹10,000</a></li>
            <li><a href="/collections/all?price_min=10000">Premium Collectibles</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- CATEGORIES DROPDOWN -->
    <div class="megamenu-panel" data-panel="categories">
      <div class="megamenu-grid-categories">
        <!-- Column 1: Art & Display -->
        <div class="megamenu-cat-col">
          <span class="cat-header">ART & DISPLAY</span>
          <ul class="cat-links-list">
            <li><a href="/collections/wled-light-boxes">WLED Light Boxes</a></li>
            <li><a href="/collections/2d-wall-art">2D Wall Art</a></li>
            <li><a href="/collections/layered-art">Layered Art</a></li>
          </ul>
        </div>
        <!-- Column 2: Scale Models -->
        <div class="megamenu-cat-col">
          <span class="cat-header">SCALE MODELS</span>
          <ul class="cat-links-list">
            <li><a href="/collections/car-models">Car Models (1:64 / 1:24 / 1:18 / 1:8)</a></li>
            <li><a href="/collections/driver-figurines">Driver Figurines</a></li>
          </ul>
        </div>
        <!-- Column 3: Accessories -->
        <div class="megamenu-cat-col">
          <span class="cat-header">ACCESSORIES</span>
          <ul class="cat-links-list">
            <li><a href="/collections/desk-accessories">Desk Accessories</a></li>
            <li><a href="/collections/keychains">Keychains</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Global Mobile Menu Takeover Overlay -->
<div id="full-menu-overlay" class="menu-overlay-new">
  <div class="mobile-menu-header">
    <span class="mobile-menu-title">NAVIGATION</span>
    <button id="menu-close-btn-mobile" class="mobile-menu-close-btn" aria-label="Close menu">CLOSE</button>
  </div>
  <div class="mobile-menu-content">
    <ul class="mobile-menu-list">
      <li class="mobile-menu-item">
        <a href="/collections/all" class="mobile-menu-link">NEW ARRIVALS</a>
      </li>

      <!-- DRIVERS Accordion -->
      <li class="mobile-menu-item mobile-accordion">
        <button class="mobile-accordion-trigger">DRIVERS <svg class="accordion-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="mobile-accordion-content">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'nav_group' %}
                {% if block.settings.group == 'active' or block.settings.group == 'alumni' %}
                  <span class="mobile-driver-header">{{ block.settings.label }}</span>
                {% endif %}
              {% when 'driver_item' %}
                <ul class="mobile-sublinks">
                  <li><a href="{{ block.settings.link }}">{{ block.settings.driver_name }}</a></li>
                </ul>
            {% endcase %}
          {% endfor %}
        </div>
      </li>

      <!-- TEAMS Accordion -->
      <li class="mobile-menu-item mobile-accordion">
        <button class="mobile-accordion-trigger">TEAMS <svg class="accordion-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="mobile-accordion-content">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'nav_group' %}
                {% if block.settings.group == 'current_1' or block.settings.group == 'current_2' or block.settings.group == 'legacy' %}
                  <span class="mobile-driver-header">{{ block.settings.label }}</span>
                {% endif %}
              {% when 'team_item' %}
                <ul class="mobile-sublinks">
                  <li><a href="{{ block.settings.link }}">{{ block.settings.team_name }}</a></li>
                </ul>
            {% endcase %}
          {% endfor %}
        </div>
      </li>

      <!-- F1 GIFTS Accordion -->
      <li class="mobile-menu-item mobile-accordion">
        <button class="mobile-accordion-trigger">F1 GIFTS <svg class="accordion-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="mobile-accordion-content">
          <ul class="mobile-sublinks">
            <li><a href="/collections/desk-accessories">For the Desk</a></li>
            <li><a href="/collections/2d-wall-art">For the Wall</a></li>
            <li><a href="/products/pitwall-gift-card">Gift Cards & Vouchers</a></li>
            <li><a href="/collections/all?price_max=5000">Gifts Under ₹5,000</a></li>
            <li><a href="/collections/all?price_min=5000&price_max=10000">Gifts Under ₹10,000</a></li>
            <li><a href="/collections/all?price_min=10000">Premium Collectibles</a></li>
          </ul>
        </div>
      </li>

      <!-- CATEGORIES Accordion -->
      <li class="mobile-menu-item mobile-accordion">
        <button class="mobile-accordion-trigger">CATEGORIES <svg class="accordion-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="mobile-accordion-content">
          <ul class="mobile-sublinks">
            <li><a href="/collections/wled-light-boxes">WLED Light Boxes</a></li>
            <li><a href="/collections/2d-wall-art">2D Wall Art</a></li>
            <li><a href="/collections/layered-art">Layered Art</a></li>
            <li><a href="/collections/car-models">Car Models</a></li>
            <li><a href="/collections/driver-figurines">Driver Figurines</a></li>
            <li><a href="/collections/desk-accessories">Desk Accessories</a></li>
            <li><a href="/collections/keychains">Keychains</a></li>
          </ul>
        </div>
      </li>
    </ul>
  </div>
  <!-- Bottom wordmark logo -->
  <div class="mobile-menu-footer">
    <span class="mobile-menu-wordmark">PITWALL</span>
  </div>
</div>

{% schema %}
{
  "name": "Header Navigation",
  "settings": [],
  "blocks": [
    {
      "type": "nav_group",
      "name": "Group Label",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Group Label (e.g. F1 Teams / Legacy F1 Teams)"
        },
        {
          "type": "select",
          "id": "group",
          "label": "Applies To Group",
          "options": [
            { "value": "current_1", "label": "Current Teams (Column 1)" },
            { "value": "current_2", "label": "Current Teams (Column 2)" },
            { "value": "legacy", "label": "Legacy F1 Teams" },
            { "value": "active", "label": "F1 Drivers" },
            { "value": "alumni", "label": "F1 Alumni" }
          ]
        }
      ]
    },
    {
      "type": "team_item",
      "name": "Team Entry",
      "settings": [
        {
          "type": "image_picker",
          "id": "team_image",
          "label": "Team Livery / Car Image"
        },
        {
          "type": "text",
          "id": "team_name",
          "label": "Team Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Collection or Page)"
        },
        {
          "type": "select",
          "id": "group",
          "label": "Column Group",
          "options": [
            { "value": "current_1", "label": "Current Teams (Column 1)" },
            { "value": "current_2", "label": "Current Teams (Column 2)" },
            { "value": "legacy", "label": "Legacy F1 Teams" }
          ],
          "default": "current_1"
        }
      ]
    },
    {
      "type": "driver_item",
      "name": "Driver Entry",
      "settings": [
        {
          "type": "image_picker",
          "id": "headshot",
          "label": "Driver Headshot"
        },
        {
          "type": "text",
          "id": "driver_name",
          "label": "Driver Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Collection or Page)"
        },
        {
          "type": "select",
          "id": "group",
          "label": "Column Group",
          "options": [
            { "value": "active", "label": "F1 Drivers" },
            { "value": "alumni", "label": "F1 Alumni" }
          ],
          "default": "active"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header Navigation",
      "blocks": [
        { "type": "nav_group", "settings": { "label": "F1 TEAMS", "group": "current_1" } },
        { "type": "nav_group", "settings": { "label": "LEGACY F1 TEAMS", "group": "legacy" } },
        { "type": "team_item", "settings": { "team_name": "RED BULL RACING", "link": "/collections/red-bull-racing", "group": "current_1" } },
        { "type": "team_item", "settings": { "team_name": "SCUDERIA FERRARI", "link": "/collections/scuderia-ferrari", "group": "current_1" } },
        { "type": "team_item", "settings": { "team_name": "MCLAREN", "link": "/collections/mclaren-f1-team", "group": "current_1" } },
        { "type": "team_item", "settings": { "team_name": "MERCEDES-AMG PETRONAS", "link": "/collections/mercedes-amg-f1-team", "group": "current_2" } },
        { "type": "team_item", "settings": { "team_name": "ASTON MARTIN", "link": "/collections/aston-martin-f1-team", "group": "current_2" } },
        { "type": "team_item", "settings": { "team_name": "WILLIAMS", "link": "/collections/williams-racing", "group": "current_2" } },
        { "type": "driver_item", "settings": { "driver_name": "MAX VERSTAPPEN", "link": "/collections/max-verstappen", "group": "active" } },
        { "type": "driver_item", "settings": { "driver_name": "LEWIS HAMILTON", "link": "/collections/lewis-hamilton", "group": "active" } },
        { "type": "driver_item", "settings": { "driver_name": "CHARLES LECLERC", "link": "/collections/charles-leclerc", "group": "active" } },
        { "type": "driver_item", "settings": { "driver_name": "LANDO NORRIS", "link": "/collections/lando-norris", "group": "active" } },
        { "type": "driver_item", "settings": { "driver_name": "OSCAR PIASTRI", "link": "/collections/oscar-piastri", "group": "active" } },
        { "type": "driver_item", "settings": { "driver_name": "GEORGE RUSSELL", "link": "/collections/george-russell", "group": "active" } }
      ]
    }
  ]
}
{% endschema %}
