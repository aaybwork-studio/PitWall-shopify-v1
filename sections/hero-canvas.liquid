
<!-- 1. Hero Section Container -->
<section class="hero-section">
  <!-- Video background container (React/Vite Mount point for playlist & mute state) -->
  <div 
    id="hero-video-root" 
    class="hero-video-container"
    data-video-playlist="[
      {%- if section.settings.video_1 != blank -%}'{{ section.settings.video_1 }}'{%- else -%}'{{ 'F1_helmet_orbiting_white_void_202605251628.mp4' | asset_url }}'{%- endif -%},
      {%- if section.settings.video_2 != blank -%}'{{ section.settings.video_2 }}'{%- else -%}'{{ 'F1_helmet_orbiting_white_void_202605251636.mp4' | asset_url }}'{%- endif -%},
      {%- if section.settings.video_3 != blank -%}'{{ section.settings.video_3 }}'{%- else -%}'{{ 'Formula_1_car_accelerates_white_202605251629.mp4' | asset_url }}'{%- endif -%}
    ]"
  >
    <div class="hero-video-fallback"></div>
  </div>

  <div class="hero-overlay"></div>

  <!-- Hero Logo Text -->
  <div class="hero-logo-wrapper">
    <h1 class="hero-title">{{ section.settings.title_text }}</h1>
  </div>

  <!-- Interactive React Mute Mount Point -->
  <div id="mute-button-root"></div>
</section>

<!-- 2. Ticker / Marquee Section -->
<section class="ticker-bar">
  <div class="ticker-track">
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
    <div class="ticker-item-1">FOR THE ONES WHO NOTICE <span class="ticker-sep-1">/</span></div>
  </div>
</section>

<!-- 3. Product Showcase Section -->
<section class="showcase-section" id="showcase">
  <div class="showcase-header scroll-reveal">
    <span class="showcase-label">THE COLLECTION</span>
    <div class="showcase-divider"></div>
  </div>

  <div class="product-grid">
    {% for product in collections.all.products limit: 4 %}
      {% assign indexes = 'a,b,c,d' | split: ',' %}
      {% assign card_class = indexes[forloop.index0] %}
      <a href="{{ product.url }}" class="product-card product-{{ card_class }} scroll-reveal cursor-pointer">
        <div class="product-image-container">
          {% if product.featured_image != blank %}
            <img class="product-img-element" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">
          {% else %}
            <div class="product-sketch-overlay">
              {% if card_class == 'a' %}
                <svg class="product-sketch-svg" viewBox="0 0 400 240" style="width: 80%; height: 80%; stroke: var(--fg); fill: none; stroke-width: 1.2">
                  <path d="M 40 120 L 360 120 M 100 80 L 180 100 L 300 100 L 330 135" stroke-dasharray="3,3" />
                  <rect x="50" y="60" width="10" height="110" stroke-width="2" opacity="0.4" />
                  <circle cx="120" cy="120" r="32" stroke-width="2" />
                  <circle cx="280" cy="120" r="35" stroke-width="2" />
                  <path d="M 190 70 L 220 30 H 260 L 280 70 Z" fill="rgba(12,12,12,0.03)" />
                </svg>
              {% elsif card_class == 'b' %}
                <svg class="product-sketch-svg" viewBox="0 0 300 240" style="width: 80%; height: 80%; stroke: var(--fg); fill: none; stroke-width: 1.2">
                  <circle cx="150" cy="120" r="60" stroke-width="2" />
                  <path d="M 150 60 C 210 60 210 180 150 180 Z" stroke-width="2" />
                  <rect x="145" y="90" width="60" height="24" fill="rgba(12,12,12,0.08)" />
                  <path d="M 90 120 H 150" stroke-dasharray="4,4" />
                </svg>
              {% elsif card_class == 'c' %}
                <svg class="product-sketch-svg" viewBox="0 0 300 240" style="width: 70%; height: 70%; stroke: var(--fg); fill: none; stroke-width: 2.5">
                  <path d="M 50 50 L 250 50 L 250 120 L 200 150 L 150 120 L 100 190 L 50 120 Z" stroke-linejoin="bevel" />
                  <circle cx="50" cy="50" r="4" fill="#F6C917" stroke="none" />
                </svg>
              {% else %}
                <svg class="product-sketch-svg" viewBox="0 0 400 240" style="width: 80%; height: 80%; stroke: var(--fg); fill: none; stroke-width: 1.2">
                  <circle cx="200" cy="120" r="60" stroke="#F6C917" stroke-width="3" />
                  <path d="M 120 120 H 280 M 200 40 V 200" stroke-dasharray="3,3" />
                  <rect x="180" y="100" width="40" height="40" fill="rgba(246,201,23,0.05)" />
                </svg>
              {% endif %}
            </div>
          {% endif %}
          <div class="product-hover-info">
            <span class="product-hover-title">{{ product.title }}</span>
            <div class="product-hover-meta">
              <span class="product-hover-specs">{{ product.type | upcase }}</span>
              <span class="product-hover-price">{{ product.price | money }}</span>
            </div>
          </div>
        </div>
      </a>
    {% else %}
      <!-- Static Mock Products matching original designs -->
      <a href="/products/mclaren-mcl39" class="product-card product-a scroll-reveal cursor-pointer">
        <div class="product-image-container">
          <div class="product-sketch-overlay">
            <svg class="product-sketch-svg" viewBox="0 0 400 240" style="width: 80%; height: 80%; stroke: var(--fg); fill: none; stroke-width: 1.2">
              <path d="M 40 120 L 360 120 M 100 80 L 180 100 L 300 100 L 330 135" stroke-dasharray="3,3" />
              <rect x="50" y="60" width="10" height="110" stroke-width="2" opacity="0.4" />
              <circle cx="120" cy="120" r="32" stroke-width="2" />
              <circle cx="280" cy="120" r="35" stroke-width="2" />
              <path d="M 190 70 L 220 30 H 260 L 280 70 Z" fill="rgba(12,12,12,0.03)" />
            </svg>
          </div>
          <div class="product-hover-info">
            <span class="product-hover-title">CAR MODELS</span>
            <div class="product-hover-meta">
              <span class="product-hover-specs">1:18 SCALE / RESIN COMPOSITE</span>
              <span class="product-hover-price">₹12,499</span>
            </div>
          </div>
        </div>
      </a>

      <div class="product-card product-b scroll-reveal">
        <div class="product-image-container">
          <div class="product-sketch-overlay">
            <svg class="product-sketch-svg" viewBox="0 0 300 240" style="width: 80%; height: 80%; stroke: var(--fg); fill: none; stroke-width: 1.2">
              <circle cx="150" cy="120" r="60" stroke-width="2" />
              <path d="M 150 60 C 210 60 210 180 150 180 Z" stroke-width="2" />
              <rect x="145" y="90" width="60" height="24" fill="rgba(12,12,12,0.08)" />
              <path d="M 90 120 H 150" stroke-dasharray="4,4" />
            </svg>
          </div>
          <div class="product-hover-info">
            <span class="product-hover-title">HELMET REPLICAS</span>
            <div class="product-hover-meta">
              <span class="product-hover-specs">1:2 SCALE / MATTE CARBON FIBER</span>
              <span class="product-hover-price">₹7,999</span>
            </div>
          </div>
        </div>
      </div>

      <div class="product-card product-c scroll-reveal">
        <div class="product-image-container">
          <div class="product-sketch-overlay">
            <svg class="product-sketch-svg" viewBox="0 0 300 240" style="width: 70%; height: 70%; stroke: var(--fg); fill: none; stroke-width: 2.5">
              <path d="M 50 50 L 250 50 L 250 120 L 200 150 L 150 120 L 100 190 L 50 120 Z" stroke-linejoin="bevel" />
              <circle cx="50" cy="50" r="4" fill="#F6C917" stroke="none" />
            </svg>
          </div>
          <div class="product-hover-info">
            <span class="product-hover-title">TRACK SILHOUETTES</span>
            <div class="product-hover-meta">
              <span class="product-hover-specs">3D TOPOGRAPHIC WOOD / STEEL</span>
              <span class="product-hover-price">₹4,499</span>
            </div>
          </div>
        </div>
      </div>

      <div class="product-card product-d scroll-reveal">
        <div class="product-image-container">
          <div class="product-sketch-overlay">
            <svg class="product-sketch-svg" viewBox="0 0 400 240" style="width: 80%; height: 80%; stroke: var(--fg); fill: none; stroke-width: 1.2">
              <circle cx="200" cy="120" r="60" stroke="#F6C917" stroke-width="3" />
              <path d="M 120 120 H 280 M 200 40 V 200" stroke-dasharray="3,3" />
              <rect x="180" y="100" width="40" height="40" fill="rgba(246,201,23,0.05)" />
            </svg>
          </div>
          <div class="product-hover-info">
            <span class="product-hover-title">DECOR LIGHTS</span>
            <div class="product-hover-meta">
              <span class="product-hover-specs">USB-C POWERED DUAL LED</span>
              <span class="product-hover-price">₹6,899</span>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<!-- 4. Manifesto Section -->
<section class="manifesto-section manifesto-punch" id="manifesto">
  <div class="manifesto-header-row">
    <span class="manifesto-label">MANIFESTO</span>
    <div class="manifesto-line-border"></div>
  </div>
  <h2 class="manifesto-headline">
    <span class="manifesto-line-small">WE DON'T MAKE FAN MERCH.</span>
    <span class="manifesto-line-large">WE MAKE OBJECTS WORTH OWNING.</span>
  </h2>
</section>

<!-- 5. About Strip Section -->
<section class="about-strip-section">
  <div class="about-left slide-from-left">
    <span class="about-label">ABOUT PITWALL</span>
    <h2 class="about-headline">PRECISION IS ITS OWN AESTHETIC.</h2>
    <p class="about-body">
      PITWALL is an India-first F1 collectibles brand for fans who understand the sport at the level of the pitwall. Not the grandstand. The wall. Where every object we make is held to the same standard as the machines we obsess over.
    </p>
    <button class="about-btn" onclick="location.href='/pages/about'">OUR STORY</button>
  </div>

  <div class="about-right slide-from-right">
    <div class="about-img-placeholder">
      <svg viewBox="0 0 400 500" style="width: 90%; height: 90%; opacity: 0.22; stroke: var(--fg); fill: none; stroke-width: 0.8">
        <path d="M 0 50 H 400 M 0 100 H 400 M 0 150 H 400 M 0 200 H 400 M 0 250 H 400 M 0 300 H 400 M 0 350 H 400 M 0 400 H 400 M 0 450 H 400" />
        <path d="M 50 0 V 500 M 100 0 V 500 M 150 0 V 500 M 200 0 V 500 M 250 0 V 500 M 300 0 V 500 M 350 0 V 500" />
        <path d="M 50 150 L 150 300 L 250 200 L 350 400" stroke="#F6C917" stroke-width="2.5" />
      </svg>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Hero WebGL Canvas",
  "settings": [
    {
      "type": "text",
      "id": "title_text",
      "label": "Hero Title",
      "default": "Pitwall"
    },
    {
      "type": "text",
      "id": "video_1",
      "label": "Video Playlist URL 1 (mp4)"
    },
    {
      "type": "text",
      "id": "video_2",
      "label": "Video Playlist URL 2 (mp4)"
    },
    {
      "type": "text",
      "id": "video_3",
      "label": "Video Playlist URL 3 (mp4)"
    }
  ],
  "presets": [
    {
      "name": "Hero WebGL Canvas"
    }
  ]
}
{% endschema %}
