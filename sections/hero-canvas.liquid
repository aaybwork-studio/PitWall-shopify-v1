      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "CTA URL",
      "default": "/pages/about"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 Value",
      "default": "ZERO"
    },
    {
      "type": "text",
      "id": "stat_1_label",
