<!-- 1. Hero Section Container -->
<section class="snap-section section-dark hero-section">
  <!-- Video background container (React/Vite Mount point for playlist & mute state) -->
  <div 
    id="hero-video-root" 
    class="hero-video-container"
    data-video-playlist="[
      {%- if section.settings.video_1 != blank -%}'{{ section.settings.video_1 }}'{%- else -%}'{{ 'F1_car_idling_on_background_202606011707.mp4' | asset_url }}'{%- endif -%},
      {%- if section.settings.video_2 != blank -%}'{{ section.settings.video_2 }}'{%- else -%}'{{ 'F1_car_overtakes_camera_overhead_202606011707.mp4' | asset_url }}'{%- endif -%},
      {%- if section.settings.video_3 != blank -%}'{{ section.settings.video_3 }}'{%- else -%}'{{ 'F1_car_slides_on_surface_202606011707.mp4' | asset_url }}'{%- endif -%},
      '{{ 'Formula_1_car_approaches_camera_202606011705.mp4' | asset_url }}',
      '{{ 'Formula_1_car_braking_and_202606011705.mp4' | asset_url }}'
    ]"
  >
    <div class="hero-video-fallback"></div>
  </div>

  <div class="hero-overlay"></div>

  <!-- Hero Content Wrapper -->
  <div class="hero-content-wrapper flex items-center justify-center h-full relative z-10">
    <div class="hero-text-container text-center">
      <h2 class="hero-tagline uppercase tracking-widest text-sm md:text-base font-mono mb-2 text-[#F6C917]">Because cars are not objects</h2>
      <h1 class="hero-title-text leading-none uppercase font-extrabold">
        {{ section.settings.title_text | default: "PITWALL" }}
      </h1>
    </div>
  </div>
  
  <!-- Ticker / Marquee Section -->
  <div class="ticker-bar absolute bottom-0 left-0 w-full z-20">
    <div class="ticker-track">
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
      <div class="ticker-item-1">PITWALL ENGINEERING <span class="ticker-sep-1">/</span></div>
    </div>
  </div>
</section>

<!-- 2. Manifesto Section -->
<section class="snap-section section-manifesto flex items-center justify-center" id="manifesto">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 w-full h-full max-h-[85vh] md:max-h-none overflow-y-auto md:overflow-hidden p-3 md:p-4">
    <!-- Left Column: large Brand Image card -->
    <div class="pw-white-card !p-0 flex items-center justify-center overflow-hidden h-full min-h-[250px] md:min-h-0">
      <img src="{{ 'desk_accessories.png' | asset_url }}" alt="Pitwall Engineering Manifesto" class="w-full h-full object-cover rounded-[5px]" />
    </div>
    
    <!-- Right Column: Title card and text card -->
    <div class="flex flex-col gap-3 h-full min-h-0">
      <!-- Top: title card (short and wide) -->
      <div class="pw-white-card flex items-center justify-center p-4 flex-[1] min-h-[64px] select-none">
        <h2 class="font-display-strict text-2xl lowercase tracking-tighter text-[#0C0C0C] font-bold">the manifesto</h2>
      </div>
      
      <!-- Bottom: body/text card (tall) -->
      <div class="pw-white-card flex flex-col justify-center p-4 md:p-6 flex-[4] min-h-0">
        <p class="font-body-strict text-sm md:text-base leading-relaxed text-[#0C0C0C]/80 italic">
          "Where every object we make is held to the same standards as the machines we obsess over."
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 2.5 Separator Video Player -->
<div 
  id="separator-video-root" 
  class="separator-video-container"
  data-video-playlist="[
    {%- if section.settings.separator_video_1 != blank -%}'{{ section.settings.separator_video_1 }}'{%- else -%}'{{ 'F1_car_slides_on_surface_202606011707.mp4' | asset_url }}'{%- endif -%},
    {%- if section.settings.separator_video_2 != blank -%}'{{ section.settings.separator_video_2 }}'{%- else -%}'{{ 'Formula_1_car_approaches_camera_202606011705.mp4' | asset_url }}'{%- endif -%},
    {%- if section.settings.separator_video_3 != blank -%}'{{ section.settings.separator_video_3 }}'{%- else -%}'{{ 'Formula_1_car_braking_and_202606011705.mp4' | asset_url }}'{%- endif -%}
  ]"
></div>

<!-- 3. The Collection Section -->
<section class="snap-section section-collection section-dark flex items-center justify-center" id="collection">
  <!-- Products data script -->
  <script id="collection-products-data" type="application/json">
    [
      {%- assign selected_collection = collections[section.settings.collection] -%}
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products limit: 20 -%}
          {
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "price": {{ product.price | money | json }},
            "image": {{ product.featured_image | img_url: '600x' | json }},
            "specs": {{ product.metafields.custom.specs | default: "1:18 SCALE / PRECISION DETAIL" | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endif -%}
    ]
  </script>
  
  <div id="collection-grid-root" class="w-full h-full"></div>
</section>

<!-- 4. About Us Section -->
<section class="snap-section section-about flex items-center justify-center" id="about">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 w-full h-full max-h-[85vh] md:max-h-none overflow-y-auto md:overflow-hidden p-3 md:p-4">
    <!-- Left Column -->
    <div class="flex flex-col gap-3 h-full min-h-0">
      <!-- Title Card (short and wide) -->
      <div class="pw-white-card flex items-center justify-center p-4 flex-[1] min-h-[64px] select-none">
        <h2 class="font-display-strict text-2xl lowercase tracking-tighter text-[#0C0C0C] font-bold">About us</h2>
      </div>
      
      <!-- Photo Card 1 (Hidden on Mobile) -->
      <div class="pw-white-card !p-0 hidden md:flex items-center justify-center overflow-hidden flex-[4] min-h-0">
        <img src="{{ 'driver_figurine.png' | asset_url }}" alt="Pitwall Engineering Driver" class="w-full h-full object-cover rounded-[5px]" />
      </div>
    </div>
    
    <!-- Right Column -->
    <div class="flex flex-col gap-3 h-full min-h-0">
      <!-- Photo Card 2 (Hidden on Mobile) -->
      <div class="pw-white-card !p-0 hidden md:flex items-center justify-center overflow-hidden flex-[4] min-h-0">
        <img src="{{ 'layered_art.png' | asset_url }}" alt="Pitwall Layered Art" class="w-full h-full object-cover rounded-[5px]" />
      </div>
      
      <!-- Quote / CTA Card (short and wide) -->
      <div class="pw-white-card flex flex-col justify-between p-4 md:p-6 flex-[1] min-h-[120px]">
        <p class="font-body-strict text-xs md:text-sm leading-relaxed text-[#0C0C0C]/80 italic mb-2">
          "Where every object we make is held to the same standards as the machines we obsess over."
        </p>
        <div>
          <button class="w-full md:max-w-[150px] h-8 border border-[#0C0C0C] bg-[#0C0C0C] text-[#EDEBE5] hover:bg-[#F6C917] hover:text-[#0C0C0C] hover:border-[#F6C917] font-mono text-[9px] uppercase tracking-wider font-bold transition-all duration-200 flex items-center justify-center gap-1 cursor-pointer" onclick="location.href='/pages/about'">
            OUR STORY
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

