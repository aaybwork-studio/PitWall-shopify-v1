      "default": "PURSUIT"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 Value",
      "default": "INFINITE"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "PRECISION"
    },
    {
      "type": "textarea",
      "id": "brand_paragraph",
      "label": "Brand Paragraph",
      "default": "Where every object we make is held to the same standards as the machines we obsess over."
    },
    {
      "type": "text",
      "id": "explore_cta_label",
      "label": "Explore CTA Label",
      "default": "EXPLORE OUR STORY"
    }
  ],
  "presets": [
    {
      "name": "Interactive Scrolly"
    }
  ]
}
{% endschema %}
