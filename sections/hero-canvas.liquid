<!-- 4. Manifesto Section -->
<section class="manifesto-section manifesto-punch" id="manifesto">
  <div class="manifesto-header-row">
    <span class="manifesto-label">MANIFESTO</span>
    <div class="manifesto-line-border"></div>
  </div>
  <h2 class="manifesto-headline">
    <span class="manifesto-line-small">WE DON'T MAKE FAN MERCH.</span>
    <span class="manifesto-line-large">WE MAKE OBJECTS WORTH OWNING.</span>
  </h2>
</section>

<!-- 5. About Strip Section -->
<section class="about-strip-section">
  <div class="about-left slide-from-left">
    <span class="about-label">ABOUT PITWALL</span>
    <h2 class="about-headline">PRECISION IS ITS OWN AESTHETIC.</h2>
    <p class="about-body">
      PITWALL is an India-first F1 collectibles brand for fans who understand the sport at the level of the pitwall. Not the grandstand. The wall. Where every object we make is held to the same standard as the machines we obsess over.
    </p>
    <button class="about-btn" onclick="location.href='/pages/about'">OUR STORY</button>
  </div>

  <div class="about-right slide-from-right">
    <div class="about-img-placeholder">
      <svg viewBox="0 0 400 500" style="width: 90%; height: 90%; opacity: 0.22; stroke: var(--fg); fill: none; stroke-width: 0.8">
        <path d="M 0 50 H 400 M 0 100 H 400 M 0 150 H 400 M 0 200 H 400 M 0 250 H 400 M 0 300 H 400 M 0 350 H 400 M 0 400 H 400 M 0 450 H 400" />
        <path d="M 50 0 V 500 M 100 0 V 500 M 150 0 V 500 M 200 0 V 500 M 250 0 V 500 M 300 0 V 500 M 350 0 V 500" />
        <path d="M 50 150 L 150 300 L 250 200 L 350 400" stroke="#F6C917" stroke-width="2.5" />
      </svg>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Hero WebGL Canvas",
  "settings": [
    {
      "type": "text",
      "id": "title_text",
      "label": "Hero Title",
      "default": "Pitwall"
    },
    {
      "type": "text",
      "id": "video_1",
      "label": "Video Playlist URL 1 (mp4)"
    },
    {
      "type": "text",
      "id": "video_2",
      "label": "Video Playlist URL 2 (mp4)"
    },
    {
      "type": "text",
      "id": "video_3",
      "label": "Video Playlist URL 3 (mp4)"
    }
  ],
  "presets": [
    {
      "name": "Hero WebGL Canvas"
    }
  ]
}
{% endschema %}
