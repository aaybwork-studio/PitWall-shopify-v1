<div 
  id="homepage-interactive-root" 
  class="w-full h-full min-h-screen relative"
  data-video-playlist="[
    {%- if section.settings.video_1 != blank -%}'{{ section.settings.video_1 }}'{%- else -%}'{{ 'F1_car_idling_on_background_202606011707.mp4' | asset_url }}'{%- endif -%},
    {%- if section.settings.video_2 != blank -%}'{{ section.settings.video_2 }}'{%- else -%}'{{ 'F1_car_overtakes_camera_overhead_202606011707.mp4' | asset_url }}'{%- endif -%},
    {%- if section.settings.video_3 != blank -%}'{{ section.settings.video_3 }}'{%- else -%}'{{ 'F1_car_slides_on_surface_202606011707.mp4' | asset_url }}'{%- endif -%},
    '{{ 'Formula_1_car_approaches_camera_202606011705.mp4' | asset_url }}',
    '{{ 'Formula_1_car_braking_and_202606011705.mp4' | asset_url }}'
  ]"
>
  <!-- Products data script -->
  <script id="collection-products-data" type="application/json">
    [
      {%- assign selected_collection = collections[section.settings.collection] -%}
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products limit: 20 -%}
          {
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "price": {{ product.price | money | json }},
            "image": {{ product.featured_image | img_url: '600x' | json }},
            "specs": {{ product.metafields.custom.specs | default: "1:18 SCALE / PRECISION DETAIL" | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endif -%}
    ]
  </script>

  <!-- Fallback Mock Images CDN mapping script -->
  <script id="fallback-images-data" type="application/json">
    {
      "mclaren.png": "{{ 'mclaren.png' | asset_url }}",
      "redbull.png": "{{ 'redbull.png' | asset_url }}",
      "ferrari.png": "{{ 'ferrari.png' | asset_url }}",
      "mercedes.png": "{{ 'mercedes.png' | asset_url }}",
      "norris.png": "{{ 'norris.png' | asset_url }}",
      "schumacher.png": "{{ 'schumacher.png' | asset_url }}",
      "verstappen.png": "{{ 'verstappen.png' | asset_url }}"
    }
  </script>

  <!-- Fallback SSR structure to prevent layout shifting on load -->
  <div class="h-screen w-full flex items-center justify-center bg-[#0C0C0C]">
    <div class="text-center font-mono text-[#EDEBE5]">
      <h1 class="hero-title-text select-none">PITWALL</h1>
      <p class="hero-tagline uppercase tracking-widest text-sm text-[#F6C917] mt-3">
        Because cars are not objects
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Interactive Scrolly",
  "settings": [
    {
      "type": "text",
      "id": "video_1",
      "label": "Video Playlist URL 1 (mp4)"
    },
    {
      "type": "text",
      "id": "video_2",
      "label": "Video Playlist URL 2 (mp4)"
    },
    {
      "type": "text",
      "id": "video_3",
      "label": "Video Playlist URL 3 (mp4)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Sourced Collection"
    }
  ],
  "presets": [
    {
      "name": "Interactive Scrolly"
    }
  ]
}
{% endschema %}
