<!-- Pitwall OS 2.0 Dynamic Routing & 404 Engine -->
{% if request.path contains '/products/' %}
  {% assign url_handle = request.path | split: '/products/' | last | split: '?' | first %}
  
  <div 
    id="product-scrollytelling-root"
    data-product-title="{{ url_handle | replace: '-', ' ' | capitalize }}"
    data-product-handle="{{ url_handle }}"
    data-product-price="{% if url_handle contains 'helmet' %}₹7,999{% else %}₹12,499{% endif %}"
    data-product-variants-json='[]'
    data-mclaren-url="{{ 'mclaren.glb' | file_url }}"
    data-redbull-url="{{ 'redbull.glb' | file_url }}"
    data-ferrari-url="{{ 'ferrari.glb' | file_url }}"
    data-mercedes-url="{{ 'mercedes.glb' | file_url }}"
    data-norris-helmet-url="{{ 'f1_helmet_lando_norris.glb' | asset_url }}"
    data-schumacher-helmet-url="{{ 'michael_schumacher_2002_helmet.glb' | asset_url }}"
    data-verstappen-helmet-url="{{ 'helmet_redbull_max_verstappen.glb' | asset_url }}"
    data-logo-url="{{ 'logo_new.png' | asset_url }}"
  >
    <!-- Brutalist loader displayed during React initialization -->
    <div style="background-color: #EDEBE5; display: flex; flex-direction: column; gap: 16px; align-items: center; justify-content: center; height: 100vh; width: 100%;">
      <span class="technical-label" style="font-family: var(--font-mono, monospace); font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(12, 12, 12, 0.4);">PITWALL // PDP ENGINE</span>
      <span class="technical-label" style="font-family: var(--font-mono, monospace); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: #7A7A7A; font-weight: 600;">CALIBRATING IMMERSIVE CHASSIS...</span>
    </div>
  </div>

{% else %}

  <!-- Standard Beautiful Brutalist 404 Design -->
  <div style="background-color: var(--bg); display: flex; flex-direction: column; gap: 32px; align-items: center; justify-content: center; min-height: 70vh; padding: 40px; text-align: center;">
    <span class="technical-label" style="font-family: var(--font-mono, monospace); font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(12, 12, 12, 0.35);">SYSTEM ERROR // 404</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(32px, 5vw, 64px); font-weight: 800; text-transform: uppercase; letter-spacing: -0.03em; line-height: 1; margin: 0; color: var(--fg);">
      PAGE NOT FOUND
    </h1>
    <p style="font-family: var(--font-mono, monospace); font-size: 11px; letter-spacing: 0.05em; color: rgba(12, 12, 12, 0.6); max-w-md; line-height: 1.6; margin: 0;">
      THE REQUESTED CHASSIS COORDINATES DO NOT EXIST IN PITWALL'S ACTIVE TELEMETRY DATABASE.
    </p>
    <button class="footer-shop-btn" onclick="location.href='/'" style="margin-top: 16px;">
      RETURN TO BASE
    </button>
  </div>

{% endif %}

{% schema %}
{
  "name": "Main 404 Handler",
  "settings": [],
  "presets": [
    {
      "name": "Main 404 Handler"
    }
  ]
}
{% endschema %}
